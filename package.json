{
  "name": "norsk",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.4",
      "better-auth": "^1.7.25",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @norsk/web dev",
    "build": "bun run --filter @norsk/web build",
    "deploy": "bun run build && bun run --filter @norsk/api deploy",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @norsk/web test:e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "content": "bun run --filter @norsk/content build",
    "audio": "bun run --filter @norsk/content audio",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "lint": "ultracite check"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "catalog:",
    "ultracite": "8.3.0"
  },
  "packageManager": "bun@1.4.2"
}
