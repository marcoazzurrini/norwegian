{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norsk",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The built app. Unknown paths get index.html, so the app's own router handles them.
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norsk",
      "database_id": "6fc80e9a-0d82-4155-aa32-fa5ad22a86a2",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "norwegian.marcoazzurrini.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
