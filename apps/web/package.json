{
  "name": "@norsk/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && cp dist/client/_shell.html dist/client/index.html && bun run build:sw",
    "build:sw": "bun build sw/sw.ts --outfile dist/client/sw.js --target browser",
    "preview": "vite preview",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sw"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@norsk/auth": "workspace:*",
    "@norsk/content": "workspace:*",
    "@norsk/engine": "workspace:*",
    "@norsk/learner": "workspace:*",
    "@norsk/protocol": "workspace:*",
    "@norsk/speech": "workspace:*",
    "@norsk/ui": "workspace:*",
    "@stylexjs/stylex": "^0.19.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "lucide-react": "^1.74.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@stylexjs/unplugin": "^0.19.2",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "catalog:",
    "vite": "^8.0.0"
  }
}
